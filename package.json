{
  "name": "maintainer-gauntlet",
  "version": "0.1.0",
  "description": "Local maintainer preflight harness for testing AI coding agents against OSS maintainer traps.",
  "type": "module",
  "license": "MIT",
  "author": "Maintainer Gauntlet contributors",
  "homepage": "https://github.com/iDogRoag/maintainer-gauntlet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iDogRoag/maintainer-gauntlet.git"
  },
  "bugs": {
    "url": "https://github.com/iDogRoag/maintainer-gauntlet/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "maintainer-gauntlet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "scenarios",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai-agent",
    "codex",
    "oss",
    "security",
    "benchmark",
    "github-actions",
    "maintainer",
    "prompt-injection",
    "agent-eval",
    "developer-tools"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
